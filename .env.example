# ── STRAPEEZZY PYTHON BACKEND ──
# Copy to .env and fill in real values

# Server
PORT=8000
ENVIRONMENT=development
FRONTEND_URL=http://localhost:8000

# Database (SQLite by default; swap for PostgreSQL on prod)
DATABASE_URL=sqlite:///./strapeezzy.db
# DATABASE_URL=postgresql://user:pass@host:5432/strapeezzy

# JWT
JWT_SECRET=change-this-to-a-random-64-char-secret-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# First superadmin (created on first boot if no users exist)
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_EMAIL=admin@strapeezzy.com
INIT_ADMIN_PASSWORD=strapeezzy2024!

# Stripe
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET
PRODUCT_PRICE_CENTS=7900

# Brevo SMTP (free tier: 300 emails/day)
# Sign up: https://app.brevo.com → SMTP & API
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your-brevo-login@email.com
BREVO_SMTP_PASS=your-brevo-smtp-key
FROM_EMAIL=hello@strapeezzy.com
FROM_NAME=Strapeezzy

# Twilio SMS (free trial ~$15 credit)
# Sign up: https://www.twilio.com/try-twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890
